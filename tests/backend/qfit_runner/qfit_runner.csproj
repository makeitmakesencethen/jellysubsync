<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>qfit_runner</AssemblyName>
    <RootNamespace>QfitRunner</RootNamespace>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
  </PropertyGroup>
  <ItemGroup>
    <!-- The plugin's own file, compiled as-is: this runs the real C#, not a copy. -->
    <Compile Include="/opt/data/jellysubsync/Jellyfin.Plugin.SubSync/Services/QualityOfFit.cs" />
    <Compile Include="Program.cs" />
  </ItemGroup>
</Project>
