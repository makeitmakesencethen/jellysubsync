# fabji's synology share, as measured from his own plugin log (2026-09-12):
#   ~10 ms per 16 KB read  AND  ~11 MB/s in aggregate
# The old SLOW profile modelled only the first half (12,8 ms per 16 KB, no per-call latency), which is why
# benchmarks on this box said "thousands of serial reads are cheap" while his server needed two minutes.
# Charge both: 1.46 ms per 16 KB is 11 MB/s, plus 10 ms per round trip.
export SLOWREAD_PREFIX=/opt/data/jf12test/media-slow/
export SLOWREAD_MS_PER_CALL=10
export SLOWREAD_MS_PER_16K=1.46
